{
  "expo": {
    "name": "On-It",
    "slug": "On-It",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/onit-logo-square.png",
    "userInterfaceStyle": "light",
    "scheme": "onit",
    "splash": {
      "image": "./assets/OnItPinPNG.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAFAF7"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.onitapp.app",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.onitapp.app",
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "dynamic"
          }
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "enableGooglePay": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "On-It uses your location to show nearby helpers exactly where you are."
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/auth"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "dbaf649d-a87e-4a6d-bad1-506e9f0905d1"
      }
    }
  }
}
