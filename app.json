{
  "expo": {
    "name": "OnIt",
    "slug": "on-it",
    "version": "1.0.0",
    "scheme": "onit",
    "orientation": "portrait",
    "icon": "./assets/onit-logo-square.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.onitapp.app",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "OnIt uses your location to show nearby helpers exactly where you are."
      }
    },
    "android": {
      "package": "com.onitapp.app",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/onit-logo-square.png"
    },
    "plugins": [
      "expo-router",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "179c2c71-86ba-4758-8e79-83754ed32e73"
      }
    }
  }
}